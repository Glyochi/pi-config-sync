{
  // Global pi-permission-system policy.
  //
  // Resolution layers, lowest to highest precedence:
  //   global policy < project policy < global agent frontmatter < project agent frontmatter
  // Wildcard sections use last-matching-rule-wins, so broad rules are listed first.
  //
  // Intent: reading is free, changing is not. Read tools and read-only shell
  // commands run without prompts; every write/edit/delete, and every chained,
  // redirected, or substituted shell command, requires approval. A few
  // destructive commands are hard-denied and cannot be relaxed by YOLO.

  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },

  "tools": {
    "*": "ask",

    // Read-only built-ins.
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",

    // File mutators: one entry per registered tool name. All stay "ask" so
    // Markdown, permission, and config changes always need user approval.
    "write": "ask",
    "edit": "ask",
    "replace": "ask",
    "insert": "ask",
    "undo_last_change": "ask",

    // pi-plan-build lifecycle tools plus its optional question tool.
    "plan_*": "allow",
    "question": "allow",

    // Non-filesystem tools.
    "task": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  },

  "bash": {
    "*": "ask",

    // Read-only inspection commands.
    "cat *": "allow",
    "head *": "allow",
    "tail *": "allow",
    "grep *": "allow",
    "rg *": "allow",
    "ls *": "allow",
    "wc *": "allow",
    "stat *": "allow",
    "file *": "allow",
    "du *": "allow",
    "df *": "allow",
    "tree *": "allow",
    "pwd": "allow",
    "which *": "allow",
    "type *": "allow",
    "env": "allow",
    "printenv*": "allow",
    "date*": "allow",

    // Read-only git inspection. Branch listing uses exact safe forms so
    // mutating variants such as "git branch -D" stay at "ask".
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "git rev-parse*": "allow",
    "git ls-files*": "allow",
    "git blame*": "allow",
    "git remote -v": "allow",
    "git branch": "allow",
    "git branch -a": "allow",
    "git branch -r": "allow",
    "git branch -v": "allow",
    "git branch -vv": "allow",
    "git branch --list": "allow",
    "git branch --show-current": "allow",

    // Chaining, redirection, substitution, and write-through options still
    // require approval. Declared after the allows so last-match-wins picks
    // these instead of the read-only allow that also matches.
    "*;*": "ask",
    "*&&*": "ask",
    "*&*": "ask",
    "*||*": "ask",
    "*|*": "ask",
    "*`*": "ask",
    "*$(*": "ask",
    "*>*": "ask",
    "*<*": "ask",
    "*\n*": "ask",
    "*--output=*": "ask",

    // Deny floors. YOLO does not relax these.
    "rm -rf *": "deny",
    "rm -fr *": "deny",
    "rm -r *": "deny",
    "git push*": "deny",
    "git reset --hard*": "deny",
    "git clean -*": "deny",
    "sudo *": "deny",
    "*sudo *": "deny",
    "*mkfs*": "deny",
    "*dd *of=/dev/*": "deny"
  },

  "skills": {
    "*": "ask"
  },

  "special": {
    "doom_loop": "ask",
    "external_directory": "ask"
  }
}
