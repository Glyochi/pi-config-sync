{
  // Global pi-permission-system policy.
  // Rationale and design notes: see PI-PERMISSIONS.md (synced by pi-config-sync).
  // Model: allow by default. Ask only for file deletes, sudo, and credential
  // access. Deny recursive force deletes.
  //
  // Bash rules match the WHOLE command string with last-matching-rule-wins, so
  // deny rules are declared last to beat the delete ask rules.

  "defaultPolicy": {
    "tools": "allow",
    "bash": "allow",
    "mcp": "allow",
    "skills": "allow",
    "special": "ask"
  },

  "tools": {
    "*": "allow",

    // Credentials: every content action asks (path-bearing built-ins).
    "read:*/auth.json": "ask",
    "write:*/auth.json": "ask",
    "edit:*/auth.json": "ask",
    "grep:*/auth.json": "ask",
    "read:*/.pi/agent/auth/*": "ask",
    "write:*/.pi/agent/auth/*": "ask",
    "edit:*/.pi/agent/auth/*": "ask",
    "grep:*/.pi/agent/auth/*": "ask",
    "read:*/.git-credentials*": "ask",
    "write:*/.git-credentials*": "ask",
    "edit:*/.git-credentials*": "ask",
    "grep:*/.git-credentials*": "ask",
    "read:*/.netrc*": "ask",
    "write:*/.netrc*": "ask",
    "edit:*/.netrc*": "ask",
    "grep:*/.netrc*": "ask",
    "read:*/.npmrc*": "ask",
    "write:*/.npmrc*": "ask",
    "edit:*/.npmrc*": "ask",
    "grep:*/.npmrc*": "ask",
    "read:*/.ssh/*": "ask",
    "write:*/.ssh/*": "ask",
    "edit:*/.ssh/*": "ask",
    "grep:*/.ssh/*": "ask",
    "read:*/.aws/*": "ask",
    "write:*/.aws/*": "ask",
    "edit:*/.aws/*": "ask",
    "grep:*/.aws/*": "ask",
    "read:*/.config/gh/*": "ask",
    "write:*/.config/gh/*": "ask",
    "edit:*/.config/gh/*": "ask",
    "grep:*/.config/gh/*": "ask",
    "read:*/.docker/config.json*": "ask",
    "write:*/.docker/config.json*": "ask",
    "edit:*/.docker/config.json*": "ask",
    "grep:*/.docker/config.json*": "ask",
    "read:*/.env*": "ask",
    "write:*/.env*": "ask",
    "edit:*/.env*": "ask",
    "grep:*/.env*": "ask",
    "read:*token*": "ask",
    "write:*token*": "ask",
    "edit:*token*": "ask",
    "grep:*token*": "ask",
    "read:*secret*": "ask",
    "write:*secret*": "ask",
    "edit:*secret*": "ask",
    "grep:*secret*": "ask",
    "read:*credential*": "ask",
    "write:*credential*": "ask",
    "edit:*credential*": "ask",
    "grep:*credential*": "ask"
  },

  "bash": {
    "*": "allow",

    // ---- File deletes ask ----
    "*rm *": "ask",
    "*rmdir *": "ask",
    "*unlink *": "ask",
    "*shred *": "ask",
    "*truncate *": "ask",
    "*find *-delete*": "ask",
    "*git clean*": "ask",
    "*git rm *": "ask",
    "*git reset --hard*": "ask",
    "*git restore*": "ask",

    // ---- sudo asks ----
    "*sudo *": "ask",

    // ---- Credentials ask (read or write) ----
    "*auth.json*": "ask",
    "*.pi/agent/auth*": "ask",
    "*.git-credentials*": "ask",
    "*.netrc*": "ask",
    "*.npmrc*": "ask",
    "*.ssh/*": "ask",
    "*.aws/*": "ask",
    "*.config/gh/*": "ask",
    "*.docker/config.json*": "ask",
    "*.env*": "ask",
    "*token*": "ask",
    "*secret*": "ask",
    "*credential*": "ask",

    // ---- Hard deny: recursive force delete (declared last so it wins) ----
    "*rm -rf *": "deny",
    "*rm -fr *": "deny",
    "*rm -r *": "deny"
  },

  "mcp": {
    "*": "allow"
  },

  "skills": {
    "*": "allow"
  },

  "special": {
    "doom_loop": "ask",
    "external_directory": "allow"
  }
}
